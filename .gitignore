# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / local env ---
.env
*.key
*.pem
credentials*
secrets*

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Raw & processed datasets (never commit data) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Model checkpoints / training artifacts ---
*.pt
*.pth
*.ckpt
*.onnx
*.pb
checkpoints/
lightning_logs/
runs/
wandb/

# --- Large generated outputs ---
results/benchmarks/*.csv
results/benchmarks/*.json
results/benchmarks/*.parquet
results/visualizations/*.png
results/visualizations/*.jpg
results/visualizations/*.pdf
!results/benchmarks/.gitkeep
!results/visualizations/.gitkeep

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.temp
_assignment_extract.txt
