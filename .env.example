# RoadVision-PDC environment variables.
# Copy to `.env` (git-ignored) and edit values explicitly.

# Dataset download gate. The downloader REFUSES to fetch anything unless
# this is set to `true` AND docs/DATASET_APPROVAL.md records instructor
# approval. Keep false until approval is granted.
DATASET_APPROVED=false

# Optional: override the download target directory (defaults to data/raw).
# RDD2022_DATA_DIR=data/raw
